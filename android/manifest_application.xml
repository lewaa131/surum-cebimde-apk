<receiver android:name="org.surutakip.reminders.ReminderReceiver" android:exported="true">
    <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
    </intent-filter>
</receiver>
<provider android:name="org.surutakip.mobile.CameraProvider"
    android:authorities="org.surutakip.surum.camera"
    android:exported="false" android:grantUriPermissions="true" />

<provider android:name="org.surutakip.mobile.UpdateProvider"
    android:authorities="org.surutakip.surum.updates"
    android:exported="false" android:grantUriPermissions="true" />
